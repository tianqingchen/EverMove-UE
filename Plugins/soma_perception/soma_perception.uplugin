{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0",
  "FriendlyName": "Soma Perception",
  "Description": "Vision (YOLO + OpenAI), microphone capture (Whisper ASR), and text input. Feeds soma_storage; no LLM.",
  "Category": "AI",
  "CreatedBy": "",
  "EnabledByDefault": false,
  "CanContainContent": false,
  "Modules": [
    {
      "Name": "soma_perception",
      "Type": "Runtime",
      "LoadingPhase": "PostDefault"
    }
  ],
  "Plugins": [
    {
      "Name": "AudioCapture",
      "Enabled": true
    },
    {
      "Name": "soma_storage",
      "Enabled": true
    }
  ]
}
